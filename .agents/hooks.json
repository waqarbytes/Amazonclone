{
  "agent-capture": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent_capture.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/agent_capture.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/agent_capture.py"
      }
    ]
  }
}
